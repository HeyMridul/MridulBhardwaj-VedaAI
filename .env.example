# Leave true to use the built-in Biology sample (no API key needed).
# Set false to extract YOUR uploaded files with OpenAI or Gemini.
DEMO_MODE=false

# Server-side only. Do not prefix with NEXT_PUBLIC_.
# No quotes around the key. Restart npm run dev after changing this.
AI_API_KEY=

# openai | gemini
# OpenAI is billed per request and will fail with "no remaining credit" when the account is empty.
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1

# Gemini example (set AI_PROVIDER, AI_MODEL, AI_BASE_URL, then put the key in AI_API_KEY above):
# AI_PROVIDER=gemini
# AI_MODEL=gemini-2.0-flash
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# Then restart npm run dev. Do not commit .env.local.